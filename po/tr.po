msgstr[1] "Hiçbir kurulu uygulamanın sahiplenmediği {n} dizin ({size}):"

#: appsweep/cli.py:195
msgid "root"
msgstr "yönetici"

#: appsweep/cli.py:201
msgid ""
"Name matching is a heuristic. Low-confidence entries are\n"
"often legitimate — review each path before removing it."
msgstr ""
"İsim eşleşmesi bir tahmindir. Düşük güvenilirlikteki kayıtlar\n"
"genelde meşrudur — silmeden önce her yolu gözden geçirin."

#: appsweep/cli.py:204
msgid "Pass --remove to delete the ones you confirm."
msgstr "Onayladıklarınızı silmek için --remove kullanın."

#: appsweep/cli.py:209
msgid "Nothing above low confidence to remove."
msgstr "Düşük güvenilirliğin üstünde kaldırılacak bir şey yok."

#: appsweep/cli.py:212
#, python-brace-format
msgid "About to remove {n} path ({size})."
msgid_plural "About to remove {n} paths ({size})."
msgstr[0] "{n} yol kaldırılmak üzere ({size})."
msgstr[1] "{n} yol kaldırılmak üzere ({size})."

#: appsweep/cli.py:248
msgid "Pick at least one of --orphans, --cache or --all."
msgstr "--orphans, --cache ya da --all seçeneklerinden en az birini verin."

#: appsweep/cli.py:272
msgid "Backends"
msgstr "Arka uçlar"

#: appsweep/cli.py:275
msgid "active"
msgstr "etkin"

#: appsweep/cli.py:276
msgid "unavailable"
msgstr "kullanılamaz"

#: appsweep/cli.py:278
#, python-brace-format
msgid "{n} item"
msgid_plural "{n} items"
msgstr[0] "{n} kalem"
msgstr[1] "{n} kalem"

#: appsweep/cli.py:287
#, python-brace-format
msgid ""
"{n} package skipped — installed by the distribution, listed under {other}"
msgid_plural ""
"{n} packages skipped — installed by the distribution, listed under {other}"
msgstr[0] ""
"{n} paket atlandı — dağıtım tarafından kurulmuş, {other} altında listeleniyor"
msgstr[1] ""
"{n} paket atlandı — dağıtım tarafından kurulmuş, {other} altında listeleniyor"

#: appsweep/cli.py:293
msgid "Reclaimable cache"
msgstr "Geri kazanılabilir önbellek"

#: appsweep/cli.py:299
msgid "Orphaned packages"
msgstr "Sahipsiz paketler"

#: appsweep/cli.py:311
msgid ""
"One uninstaller for apt, dnf, pacman, Flatpak, Snap and AppImage — with "
"leftover cleanup."
msgstr ""
"apt, dnf, pacman, Flatpak, Snap ve AppImage için tek kaldırma aracı — "
"kalıntı temizliğiyle birlikte."

#: appsweep/cli.py:318
msgid "limit to a source (apt, dnf, pacman, flatpak, snap, appimage)"
msgstr "tek bir kaynakla sınırla (apt, dnf, pacman, flatpak, snap, appimage)"

#: appsweep/cli.py:321
msgid "list installed software"
msgstr "kurulu yazılımları listele"

#: appsweep/cli.py:322
msgid "filter by name"
msgstr "ada göre filtrele"

#: appsweep/cli.py:324
msgid "include libraries and runtimes"
msgstr "kütüphaneleri ve çalışma zamanlarını da dahil et"

#: appsweep/cli.py:325
msgid "largest first"
msgstr "en büyük önce"

#: appsweep/cli.py:330
msgid "uninstall software and its leftovers"
msgstr "yazılımı ve kalıntılarını kaldır"

#: appsweep/cli.py:333
msgid "remove but keep system config files (no purge)"
msgstr "kaldır ama sistem ayar dosyalarını koru (tam kaldırma yapma)"

#: appsweep/cli.py:335
msgid "do not scan for or delete leftover user data"
msgstr "kalıntı kullanıcı verisini tarama ve silme"

#: appsweep/cli.py:337
msgid "leave unused dependencies installed"
msgstr "kullanılmayan bağımlılıkları kurulu bırak"

#: appsweep/cli.py:339
msgid "only delete leftovers matched with high confidence"
msgstr "yalnızca yüksek güvenilirlikle eşleşen kalıntıları sil"

#: appsweep/cli.py:342
msgid "delete outright instead of moving to the trash"
msgstr "çöp kutusuna taşımak yerine doğrudan sil"

#: appsweep/cli.py:344
msgid "take the first match instead of refusing"
msgstr "reddetmek yerine ilk eşleşmeyi al"

#: appsweep/cli.py:351
msgid "find residue from software already removed"
msgstr "hâlihazırda kaldırılmış yazılımların kalıntılarını bul"

#: appsweep/cli.py:353
msgid "also scan ~/.cache"
msgstr "~/.cache dizinini de tara"

#: appsweep/cli.py:355
msgid "skip /etc, /var/lib and /opt"
msgstr "/etc, /var/lib ve /opt dizinlerini atla"

#: appsweep/cli.py:357
msgid "hide low-confidence guesses"
msgstr "düşük güvenilirlikteki tahminleri gizle"

#: appsweep/cli.py:359
msgid "delete the medium and high confidence entries"
msgstr "orta ve yüksek güvenilirlikteki kayıtları sil"

#: appsweep/cli.py:365
msgid "orphans and package-manager caches"
msgstr "sahipsiz paketler ve paket yöneticisi önbellekleri"

#: appsweep/cli.py:374
msgid "what AppSweep can see on this system"
msgstr "AppSweep'in bu sistemde neleri gördüğü"

#: appsweep/cli.py:385
msgid "Interrupted."
msgstr "Yarıda kesildi."

#: appsweep/selfremove.py:83
msgid "Installed as a Debian package ({pkg})"
msgstr "Debian paketi olarak kurulmuş ({pkg})"

#: appsweep/selfremove.py:92
msgid "Installed as an RPM package ({pkg})"
msgstr "RPM paketi olarak kurulmuş ({pkg})"

#: appsweep/selfremove.py:99
msgid "Installed with pacman ({pkg})"
msgstr "pacman ile kurulmuş ({pkg})"

#: appsweep/selfremove.py:112
msgid "Installed for this user only, under {prefix}"
msgstr "Yalnızca bu kullanıcı için kurulmuş, {prefix} altında"

#: appsweep/selfremove.py:121
msgid "Running from a source folder, not installed"
msgstr "Kaynak klasöründen çalışıyor, kurulu değil"

#: appsweep/selfremove.py:192
msgid "Removing AppSweep"
msgstr "AppSweep kaldırılıyor"

#: appsweep/selfremove.py:193
msgid "Finished. Press Enter to close this window."
msgstr "Bitti. Bu pencereyi kapatmak için Enter'a basın."

#: appsweep/ui/app.py:98
msgid ""
"One uninstaller for every way Linux installs software.\n"
"\n"
"AppSweep lists what apt, dnf, pacman, Flatpak, Snap, AppImage, pip, pipx, "
"npm and cargo have put on this machine, removes any of it in one step, and "
"then finds the settings, caches and data that uninstalling leaves behind."
msgstr ""
"Linux'ta kurduğunuz her yazılımı tek bir yerden kaldırın.\n"
"\n"
"AppSweep; apt, dnf, pacman, Flatpak, Snap, AppImage, pip, pipx, npm ve "
"cargo'nun bu makineye koyduğu her şeyi listeler, seçtiklerinizi tek adımda "
"kaldırır ve ardından kaldırma işleminin geride bıraktığı ayarları, "
"önbellekleri ve verileri bulur."

#. TRANSLATORS: put your name here, one per line.
#: appsweep/ui/app.py:115
msgid "translator-credits"
msgstr "Muhammed Şükrü SEZER"

#: appsweep/ui/app.py:117
msgid "Source code"
msgstr "Kaynak kodu"

#: appsweep/ui/app.py:118
msgid "Uninstall AppSweep…"
msgstr "AppSweep'i Kaldır…"

#: appsweep/ui/app.py:121
msgid "Built on"
msgstr "Üzerine kurulduğu projeler"

#: appsweep/ui/app.py:129
msgid "Safety rules"
msgstr "Güvenlik kuralları"

#: appsweep/ui/app.py:131
msgid "Protected paths are refused outright"
msgstr "Korunan yollar koşulsuz reddedilir"

#: appsweep/ui/app.py:132
msgid "Leftovers go to the trash, not /dev/null"
msgstr "Kalıntılar /dev/null'a değil, çöp kutusuna gider"

#: appsweep/ui/app.py:133
msgid "Every command is shown before it runs"
msgstr "Her komut çalışmadan önce gösterilir"

#: appsweep/ui/app.py:137
msgid "Icon"
msgstr "Simge"

#: appsweep/ui/app.py:138
msgid ""
"The application icon is part of AppSweep and is released under the same "
"licence. It follows the GNOME icon template and uses the GNOME palette."
msgstr ""
"Uygulama simgesi AppSweep'in parçasıdır ve aynı lisansla dağıtılır. GNOME "
"simge şablonunu izler ve GNOME paletini kullanır."

#: appsweep/ui/app.py:163
msgid "Nothing to uninstall"
msgstr "Kaldırılacak bir şey yok"

#: appsweep/ui/app.py:164
msgid ""
"This copy is running straight from a source folder, so nothing has been installed on the system.\n"
"\n"
"{path}"
msgstr ""
"Bu kopya doğrudan bir kaynak klasöründen çalışıyor, yani sisteme kurulmuş bir şey yok.\n"
"\n"
"{path}"

#: appsweep/ui/app.py:168 appsweep/ui/app.py:188 appsweep/ui/app.py:210
#: appsweep/ui/app.py:223 appsweep/ui/removal.py:182
msgid "Close"
msgstr "Kapat"

#: appsweep/ui/app.py:175
msgid "This runs in a terminal window, where you can read it and confirm it:"
msgstr "Şu komut bir terminal penceresinde çalışacak; orada okuyup onaylayabilirsiniz:"

